# The a2a chatops gateway image.
#
# PLAYGROUND POSTURE: static per-component NATS users instead of the auth
# callout, bot token as a plain Secret, no exporter, no breaker, gateway
# sweep as the only janitor. Each of these has a decided design in
# docs/designs/spec-nats-deployment.md and spec-chatops-gateway.md; the auth
# callout is the product path and stage 2 work. Static creds are the
# playground, not the product.
#
# Build from the a2a/ module root:
#   docker build -f Dockerfile.gateway -t <registry>/gateway:<tag> .

FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/gateway ./cmd/gateway

# Distroless nonroot satisfies the Deployment's runAsNonRoot, but it does not match its
# runAsUser: this image's USER is 65532 and the pod imposes 1000. That override is why the
# Deployment sets WorkingDir explicitly -- the image's WORKDIR /home/nonroot is 0700 owned
# by 65532, which 1000 cannot chdir into. See hardenedSecurityContext() and #1259.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gateway /gateway
USER nonroot
ENTRYPOINT ["/gateway"]
